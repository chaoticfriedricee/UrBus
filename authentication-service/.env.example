# ==========================================
# App
# ==========================================
NODE_ENV=development
PORT=5166
FRONTEND_URL=http://localhost:5173

# ==========================================
# Database (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5435
DB_NAME=urbus_users
DB_USER=UrBus
DB_PASSWORD=change-me
DB_LOGGING=false

# ==========================================
# JWT
# ==========================================
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=UrBus
JWT_AUDIENCE=UrBus
JWT_EXPIRATION_MINUTES=60

# ==========================================
# Cloudinary
# ==========================================
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me
CLOUDINARY_BASE_URL=https://res.cloudinary.com/change-me/image/upload/
CLOUDINARY_FOLDER=auth_ks_in6av/profiles
CLOUDINARY_DEFAULT_AVATAR=avatarDefault-1749508519496.png

# ==========================================
# SMTP (Email)
# ==========================================
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_IMPLICIT_SSL=true
SMTP_USER=change-me@gmail.com
SMTP_PASSWORD=change-me-app-password
SMTP_FROM_EMAIL=change-me@gmail.com
SMTP_FROM_NAME=UrBus Support
SMTP_TIMEOUT_MS=30000
SMTP_USE_FALLBACK=false
SMTP_IGNORE_CERTIFICATE_ERRORS=false

# ==========================================
# Security / CORS
# ==========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://localhost:3000,https://localhost:3001
ADMIN_ALLOWED_ORIGINS=http://localhost:3000

# ==========================================
# Rate limiting
# ==========================================
AUTH_RATE_LIMIT_WINDOW_MINUTES=1
AUTH_RATE_LIMIT_MAX=5
API_RATE_LIMIT_WINDOW_MINUTES=1
API_RATE_LIMIT_MAX=100
