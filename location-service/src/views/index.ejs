<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UrBus - Mapa</title>
    <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@5.6.1/dist/maplibre-gl.css">
    <link rel="stylesheet" href="/UrBus/v1/css/main.css">
</head>
<body>
    <div
        id="map-template"
        data-map-style="<%= mapStyleUrl %>"
        aria-label="Mapa informativo de calles"
    ></div>
    <div id="route-summary" role="status" aria-live="polite">
        El seguimiento de recorridos está disponible en las aplicaciones UrBus con una sesión iniciada.
    </div>
    <script src="https://unpkg.com/maplibre-gl@5.6.1/dist/maplibre-gl.js"></script>
    <script src="/UrBus/v1/js/main.js"></script>
</body>
</html>